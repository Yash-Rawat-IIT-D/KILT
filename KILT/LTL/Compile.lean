import KILT.LTL.TableauCorrect

/-!
# Verified formula compilation

This module brings the semantic compilation pipeline together for a public LTL
formula. It normalizes the formula to NNF, constructs the finite generalized
tableau whose states are consistent subformula assignments, and applies the
verified round-robin conversion to obtain an ordinary `FiniteBuchi`. The
resulting automaton has KILT's executable finite structure and is interpreted
through CSLib's infinite-run and Büchi-acceptance interfaces.

There are two closely related compiler outputs:

* `toBuchi φ` recognizes exactly the infinite valuation words satisfying `φ`.
  Its theorem composes normalization correctness, tableau language correctness,
  and generalized-to-ordinary Büchi language preservation.
* `violationAutomaton φ` compiles `¬φ`, so it recognizes exactly the words that
  violate `φ`. This is the automaton later synchronized with a finite Kripke
  structure: accepting product paths are feasible counterexample executions.

This file proves word-language correctness independently of any model. The
later product theorem connects automaton acceptance to initial Kripke paths,
and `FiniteKripke.check_correct` is the final Boolean result: `check = true` iff
all initial infinite executions satisfy the original formula. Counterexample
soundness additionally connects a returned finite lasso to its own violating
projected execution.

Compilation needs decidable equality on atoms, not a finite atom type or an
enumeration of all valuations: the automaton consumes the valuation supplied at
each word or model position. The explicit tableau has an exponential powerset
bound in the number of normalized subformulas, and round-robin conversion adds
a factor for the until obligations. This is a verified reference construction,
not an optimized on-demand translator.
-/
namespace KILT.LTL.Formula
open Cslib.Automata
universe u
variable {AP : Type u} [DecidableEq AP]

/-- The state type of the compiled ordinary Büchi automaton. The first component
is one statically consistent tableau assignment for `φ.normalize`; the second
is the round-robin counter recording which generalized until-acceptance set is
currently awaited. -/
abbrev AutomatonState (φ : Formula AP) :=
  Tableau.State φ.normalize × (Tableau.toGeneralizedBuchi φ.normalize).Counter

/-- Compile a public formula into an executable ordinary finite Büchi automaton:
normalize to NNF, construct its generalized tableau, then add the verified
round-robin counter. The `.toCSLib` adapter supplies the infinite-word language
used in `toBuchi_accepts`. -/
def toBuchi (φ : Formula AP) : Automata.FiniteBuchi (AutomatonState φ) (Valuation AP) :=
  (Tableau.toGeneralizedBuchi φ.normalize).toFiniteBuchi

/-- Correctness of positive formula compilation at the word-language boundary:
the compiled ordinary Büchi automaton accepts exactly the infinite valuation
words satisfying the original public formula.

This composes `Tableau.toFiniteBuchi_accepts` with semantic preservation of
normalization. It is independent of Kripke models, seriality, products, and
graph search; those layers consume this language theorem later. -/
theorem toBuchi_accepts (φ : Formula AP) (word : Word AP) :
    ωAcceptor.Accepts φ.toBuchi.toCSLib word ↔ WordSat word φ := by
  rw [toBuchi, Tableau.toFiniteBuchi_accepts]
  exact φ.wordSat_normalize word

/-- Compile the negation of the supplied property. The resulting ordinary
Büchi automaton is the property monitor used by model checking: its accepted
language consists of candidate counterexample words for `φ`. Product
construction later restricts those candidates to words generated by the
Kripke model. -/
def violationAutomaton (φ : Formula AP) :
    Automata.FiniteBuchi (AutomatonState (.neg φ)) (Valuation AP) :=
  (Formula.neg φ).toBuchi

/-- Correctness of violation-language compilation: the violation automaton
accepts an infinite valuation word exactly when that word does not satisfy
`φ`. This is the language premise used by `checkAgainst_correct`, which turns
absence of accepted product paths into universal model satisfaction. -/
theorem violationAutomaton_accepts (φ : Formula AP) (word : Word AP) :
    ωAcceptor.Accepts φ.violationAutomaton.toCSLib word ↔ ¬ WordSat word φ :=
  (Formula.neg φ).toBuchi_accepts word

/-- A structural upper bound for the explicit compiled state space: at most one
tableau state for every subset of normalized subformulas, multiplied by the
round-robin counter size. Static consistency may remove assignments, so this is
an upper bound rather than an exact count; it also excludes the later Kripke
product factor. -/
theorem card_automatonState_le (φ : Formula AP) :
    Fintype.card (AutomatonState φ) ≤
      2 ^ φ.normalize.subformulas.card * max 1 (Tableau.untilObligations φ.normalize).length := by
  change Fintype.card (Tableau.State φ.normalize ×
    Fin (max 1 (Tableau.toGeneralizedBuchi φ.normalize).accepting.length)) ≤ _
  simp only [Fintype.card_prod, Fintype.card_fin, Tableau.toGeneralizedBuchi, List.length_map]
  exact Nat.mul_le_mul_right _ (Tableau.card_state_le _)

end KILT.LTL.Formula
